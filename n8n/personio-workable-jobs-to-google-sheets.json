{
  "name": "Jobs from Personio, Workable, Recruitee, SmartRecruiters, Teamtailor career sites to Google Sheets",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "b24a015f-9349-5759-9a5e-97c346f9c00d",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/swissalpinedata~eu-ats-jobs/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ companies: [\"https://ottonova.jobs.personio.de\", \"https://apply.workable.com/blueground\", \"https://bunq.recruitee.com\", \"https://polestar.teamtailor.com\"], includeDescription: false, maxItems: 1000 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "d3b98531-8ddb-5189-abc8-06e2075677c7",
      "name": "Run Apify actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify token (Authorization: Bearer ...)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const keep = [\"company_name\", \"title\", \"department\", \"city\", \"country\", \"remote\", \"employment_type\", \"published_at\", \"source\", \"url\"];\nreturn $input.all().map(({ json }) => ({\n  json: Object.fromEntries(keep.map((k) => [k, json[k] ?? \"\"])),\n}));\n"
      },
      "id": "8788e37a-02ea-542d-b176-ce540bd6406a",
      "name": "Pick columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "url"
          ]
        },
        "options": {}
      },
      "id": "8004e3a6-b466-5060-b33c-9a6ee21ca41f",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
