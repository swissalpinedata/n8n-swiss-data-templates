      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Configuration').first().json.sheetUrl }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Configuration').first().json.sheetTab }}"
        },
        "options": {}
      },
      "id": "6b4ab6bd-56c6-5d63-ad79-aff5077c2262",
      "name": "Read companies already in sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Rows already in the sheet are skipped, so the overlapping date window never adds a company twice.\nconst known = new Set($input.all().map((i) => String(i.json.uid ?? '')).filter(Boolean));\nconst fresh = [];\nfor (const item of $('Match target profile').all()) {\n  if (known.has(item.json.uid)) continue;\n  known.add(item.json.uid);\n  fresh.push({ json: item.json });\n}\nreturn fresh;\n"
      },
      "id": "e20a7612-29f6-5a54-bad4-cff739078144",
      "name": "Keep only new companies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
