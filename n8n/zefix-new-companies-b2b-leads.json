      "id": "c767ba79-9ad2-55cd-b227-f148292e88ba",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/swissalpinedata~swiss-company-register-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: \"new-companies\", cantons: $json.cantons.split(\",\").map((c) => c.trim().toUpperCase()).filter(Boolean), subRubrics: [\"HR01\"], dateFrom: $today.minus({ days: Number($json.lookbackDays) }).toFormat(\"yyyy-MM-dd\"), maxItems: Number($json.maxItems) }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "f6c7fac3-5ca2-5205-82a0-22a05cfa1053",
      "name": "Fetch new registrations from SHAB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const list = (s) => String(s ?? '').split(',').map((x) => x.trim().toLowerCase()).filter(Boolean);\nconst c = $('Configuration').first().json;\nconst codes = list(c.legalFormCodes);\nconst include = list(c.includeKeywords);\nconst exclude = list(c.excludeKeywords);\n\nconst rows = [];\nfor (const { json: r } of $input.all()) {\n  const text = `${r.name ?? ''} ${r.purpose ?? ''}`.toLowerCase();\n  if (codes.length && !codes.includes(String(r.legal_form_code))) continue;\n  if (exclude.some((w) => text.includes(w))) continue;\n  const hits = include.filter((w) => text.includes(w));\n  if (include.length && !hits.length) continue;\n  rows.push({\n    json: {\n      uid: r.uid,\n      name: r.name,\n      legal_form: r.legal_form,\n      seat: r.seat,\n      canton: r.canton,\n      address: r.address ?? '',\n      purpose: r.purpose ?? '',\n      matched_keywords: hits.join(', '),\n      published: r.publication_date,\n      shab_url: r.url,\n    },\n  });\n}\nreturn rows;\n"
      },
      "id": "7488de5e-3386-540f-9200-ab42b853b8d6",
      "name": "Match target profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
